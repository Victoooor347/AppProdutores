# Cole aqui a connection string do Neon (Dashboard do Neon → Connection Details)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=require

PORT=3000

# ---------------------------------------------------------------
# E-mail (códigos de primeiro acesso e recuperação de senha)
# Deixe SMTP_HOST vazio em desenvolvimento: o e-mail não é enviado e o
# conteúdo (com o código) aparece no terminal da API.
# ---------------------------------------------------------------
# Exemplos:
#   Office 365 / Outlook da empresa: smtp.office365.com, porta 587
#   Google Workspace / Gmail (senha de app): smtp.gmail.com, porta 587
#   SendGrid: smtp.sendgrid.net, porta 587, usuário "apikey"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente que aparece pro produtor
SMTP_FROM="Dickow Produtores <nao-responda@seudominio.com.br>"
